---
import Layout from "../../layouts/Layout.astro";
import Post from "../../components/Post.astro";
import Icon from "../../components/Icon.astro";
import { getNoticias, mediaUrl } from "../../lib/noticias";
import { site, stats } from "../../data/site";

const posts = await getNoticias();
/** Posts visibles al cargar; el resto aparece al hacer scroll. */
const FIRST = 5;
const photos = posts.flatMap((p) => p.data.images.map((img) => ({ ...img, src: mediaUrl(img.src), post: p.id }))).slice(0, 9);

const intro = [
  { icon: "pin", text: `${site.municipio}, ${site.estado}` },
  { icon: "users", text: `${stats.ejidatarios} ejidatarios · fundado en ${stats.fundacion}` },
  { icon: "award", text: "Manejo forestal certificado FSC" },
  { icon: "tree", text: `${stats.superficie.toLocaleString("es-MX")} hectáreas de bosque` },
] as const;
---

<Layout title="Noticias" description="Publicaciones, proyectos y la vida diaria del Ejido San Diego de Tezains.">
  <!-- Portada tipo perfil -->
  <section class="bg-white pt-28 shadow-sm sm:pt-32">
    <div class="mx-auto max-w-5xl">
      <div class="relative aspect-[16/7] overflow-hidden sm:aspect-[16/5] sm:rounded-b-2xl">
        <img src="/images/hero.jpg" srcset="/images/hero-sm.jpg 900w, /images/hero.jpg 1600w" sizes="(min-width: 1024px) 1024px, 100vw" alt="" fetchpriority="high" class="size-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-t from-forest-950/40 to-transparent"></div>
      </div>
      <div class="flex flex-col items-center gap-4 px-4 pb-6 text-center sm:flex-row sm:items-end sm:px-8 sm:text-left">
        <img src="/images/logo.png" alt={site.name} class="relative z-10 -mt-14 size-28 shrink-0 rounded-full bg-forest-950 object-contain p-3 ring-4 ring-white sm:-mt-12 sm:size-36" />
        <div class="min-w-0 flex-1 sm:pb-2">
          <h1 class="text-2xl font-semibold text-forest-900 sm:text-3xl">{site.name}</h1>
          <p class="mt-1 text-sm text-ink/60">{site.tagline}</p>
        </div>
        <div class="flex gap-2 sm:pb-3">
          <a href={site.facebook} target="_blank" rel="noopener" class="btn-dark !py-2"><Icon name="facebook" class="size-4" /> Facebook</a>
          <a href="#contacto" class="btn-outline !py-2">Contacto</a>
        </div>
      </div>
    </div>
  </section>

  <div class="mx-auto grid max-w-5xl gap-6 px-3 py-6 sm:px-4 lg:grid-cols-[20rem_minmax(0,1fr)] lg:items-start">
    <!-- Columna de información (como "Detalles" en un perfil) -->
    <aside class="space-y-4 lg:sticky lg:top-32">
      <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-forest-900/5">
        <h2 class="font-sans text-lg font-semibold text-forest-900">Información</h2>
        <ul class="mt-3 space-y-3 text-sm text-ink/75">
          {intro.map((i) => (
            <li class="flex items-start gap-3"><Icon name={i.icon} class="mt-0.5 size-5 shrink-0 text-leaf-600" />{i.text}</li>
          ))}
        </ul>
        <a href="/nosotros" class="btn-outline mt-4 w-full justify-center !py-2">Conoce el ejido</a>
      </div>
      {
        photos.length > 0 && (
          <div class="hidden rounded-2xl bg-white p-5 shadow-sm ring-1 ring-forest-900/5 lg:block">
            <h2 class="font-sans text-lg font-semibold text-forest-900">Fotos</h2>
            <div class="mt-3 grid grid-cols-3 gap-1 overflow-hidden rounded-xl">
              {photos.map((p) => (
                <a href={`#${p.post}`} class="aspect-square overflow-hidden bg-cream">
                  <img src={p.src} alt={p.alt} loading="lazy" class="size-full object-cover transition hover:scale-105" />
                </a>
              ))}
            </div>
          </div>
        )
      }
    </aside>

    <!-- Feed -->
    <div class="min-w-0 space-y-5" data-feed>
      {posts.map((post, i) => <Post post={post} later={i >= FIRST} />)}
      {posts.length === 0 && <p class="rounded-2xl bg-white p-8 text-center text-ink/60">Aún no hay publicaciones.</p>}
      <div data-sentinel class="flex justify-center py-6 text-sm text-ink/40" hidden={posts.length <= FIRST}>Cargando más publicaciones…</div>
      {posts.length > 0 && <p data-end hidden={posts.length > FIRST} class="py-6 text-center text-sm text-ink/40">No hay más publicaciones</p>}
    </div>
  </div>

  <!-- Visor de fotos -->
  <dialog data-lightbox class="m-0 h-dvh max-h-none w-screen max-w-none bg-black/95 p-0 text-white backdrop:bg-black/80">
    <div class="relative flex size-full items-center justify-center select-none" data-stage>
      <img data-lb-img alt="" class="max-h-full max-w-full object-contain" />
      <p data-lb-count class="absolute top-4 left-4 rounded-full bg-black/50 px-3 py-1 text-sm"></p>
      <button type="button" data-lb-close class="absolute top-3 right-3 grid size-11 place-items-center rounded-full bg-white/10 text-2xl hover:bg-white/20" aria-label="Cerrar">×</button>
      <button type="button" data-lb-prev class="absolute left-3 grid size-11 place-items-center rounded-full bg-white/10 hover:bg-white/20" aria-label="Anterior">
        <Icon name="chevron" class="size-6 rotate-180" />
      </button>
      <button type="button" data-lb-next class="absolute right-3 grid size-11 place-items-center rounded-full bg-white/10 hover:bg-white/20" aria-label="Siguiente">
        <Icon name="chevron" class="size-6" />
      </button>
      <p data-lb-alt class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 px-6 pt-10 pb-5 text-center text-sm text-white/80"></p>
    </div>
  </dialog>

  <script>
    import "../../scripts/feed.ts";
  </script>
</Layout>
