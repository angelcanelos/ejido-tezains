---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<a href="/" class={`group inline-flex items-center ${className}`} aria-label="Ejido San Diego de Tezains — inicio">
  <img
    src="/images/logo.png"
    alt="San Diego de Tezains"
    width="400"
    height="162"
    decoding="async"
    class="h-14 w-auto sm:h-16 shrink-0 transition-transform duration-500 group-hover:scale-105"
  />
</a>
