---
import { site } from "../data/site";
import { formatDate, formatPostText, mediaUrl, plainText, type Noticia } from "../lib/noticias";

interface Props {
  post: Noticia;
  /** Los posts con `later` se muestran al hacer scroll (carga progresiva). */
  later?: boolean;
}
const { post, later = false } = Astro.props;
const { date } = post.data;
const images = post.data.images.map((img) => ({ src: mediaUrl(img.src), alt: img.alt }));
const text = plainText(post);
const long = text.length > 420 || text.split("\n").length > 7;

// Mosaico tipo Facebook: 1 foto grande; 2 lado a lado; 3+ una grande y el resto apiladas (máx. 4 visibles).
const shown = images.slice(0, 4);
const extra = images.length - shown.length;
const layout =
  images.length === 1
    ? ""
    : images.length === 2
      ? "grid-cols-2 aspect-[2/1]"
      : images.length === 3
        ? "grid-cols-3 grid-rows-2 aspect-[3/2]"
        : "grid-cols-3 grid-rows-3 aspect-square sm:aspect-[6/5]";
const tileClass = (i: number) =>
  images.length >= 3 && i === 0 ? (images.length === 3 ? "col-span-2 row-span-2" : "col-span-2 row-span-3") : "";
---

<article
  id={post.id}
  data-post
  data-later={later ? "" : undefined}
  hidden={later}
  data-images={JSON.stringify(images)}
  class="scroll-mt-28 overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-forest-900/5"
>
  <header class="flex items-center gap-3 px-4 pt-4">
    <img src="/images/logo.png" alt="" class="size-11 shrink-0 rounded-full bg-forest-950 object-contain p-1 ring-2 ring-leaf-500/70" />
    <div class="min-w-0 flex-1 leading-tight">
      <p class="truncate font-semibold text-forest-900">{site.name}</p>
      <a href={`/noticias#${post.id}`} class="mt-0.5 inline-flex items-center gap-1.5 text-xs text-ink/55 hover:underline">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span aria-hidden="true">·</span>
        <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" aria-label="Público"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" /></svg>
      </a>
    </div>
    <button type="button" data-share class="relative grid size-9 place-items-center rounded-full text-ink/50 transition hover:bg-forest-900/5 hover:text-forest-900" title="Compartir">
      <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4" /></svg>
    </button>
  </header>

  {
    text && (
      <div class="px-4 pt-3 pb-3">
        <div data-text class:list={["text-[0.95rem] leading-relaxed whitespace-pre-line text-ink/90 sm:text-base", long && "line-clamp-6"]} set:html={formatPostText(text)} />
        {long && <button type="button" data-more class="mt-1 text-sm font-semibold text-ink/60 hover:underline">Ver más</button>}
      </div>
    )
  }

  {
    images.length > 0 && (
      <div class:list={["mt-1 grid gap-0.5 bg-forest-900/5", layout]}>
        {shown.map((img, i) => (
          <button type="button" data-open={i} class:list={["group relative block overflow-hidden", tileClass(i)]} aria-label={`Ver foto ${i + 1} de ${images.length}`}>
            <img
              src={img.src}
              alt={img.alt}
              loading="lazy"
              decoding="async"
              class:list={[
                "w-full object-cover transition duration-500 group-hover:scale-[1.03] group-hover:brightness-95",
                images.length === 1 ? "h-auto max-h-[42rem]" : "size-full",
              ]}
            />
            {extra > 0 && i === shown.length - 1 && (
              <span class="absolute inset-0 grid place-items-center bg-forest-950/55 text-3xl font-semibold text-white">+{extra}</span>
            )}
          </button>
        ))}
      </div>
    )
  }

  <div class="h-4"></div>
</article>
