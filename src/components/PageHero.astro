---
interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  image: string;
}
const { eyebrow, title, subtitle, image } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-forest-950 pt-36 pb-20 text-white sm:pt-44 sm:pb-28">
  <div class="absolute inset-0 -z-10 overflow-hidden">
    <img src={image} alt="" class="slow-zoom size-full object-cover [--zoom-to:1.1]" data-parallax="0.25" />
  </div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-forest-950/95 via-forest-950/70 to-forest-950/30"></div>
  <div class="absolute inset-x-0 bottom-0 -z-10 h-24 bg-gradient-to-t from-forest-950/60 to-transparent"></div>
  <div class="container-x hero-in max-w-3xl">
    <p class="eyebrow !text-leaf-400">{eyebrow}</p>
    <h1 class="mt-3 text-4xl leading-[1.05] font-semibold sm:text-6xl">{title}</h1>
    {subtitle && <p class="mt-5 max-w-xl text-base text-white/80 sm:text-lg">{subtitle}</p>}
    <slot />
  </div>
</section>
